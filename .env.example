# Copy this file to .env and replace every change-me value.
DATABASE_URL=postgres://relay:relay@127.0.0.1:5432/relay
POSTGRES_PASSWORD=change-me-with-a-long-random-database-password
PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
KEY_PEPPER=change-me-with-at-least-32-random-characters
DEVICE_TOKEN_PEPPER=change-me-with-a-different-32-character-secret
WEBHOOK_SIGNING_SECRET=change-me-with-a-third-32-character-secret
METRICS_BEARER_TOKEN=change-me-with-a-fourth-32-character-secret
RELAY_BOOTSTRAP_API_KEY=
LOG_LEVEL=info
REQUIRE_HTTPS=false
TRUST_PROXY_HEADERS=false
MAX_OUTSTANDING_JOBS_PER_ACCOUNT=1000
MAX_SYNCHRONOUS_REQUESTS_PER_KEY=5
MAX_SSE_CONNECTIONS_PER_KEY=10
